# Development only. Run python3 scripts/init_env.py to generate local secrets.
POSTGRES_DB=findie
POSTGRES_USER=findie
POSTGRES_PASSWORD=GENERATE_DATABASE_PASSWORD
POSTGRES_PORT=5432
POSTGRES_APP_USER=findie_app
POSTGRES_APP_PASSWORD=GENERATE_APP_DATABASE_PASSWORD
SEARCH_POSTGRES_DB=findie_search
SEARCH_POSTGRES_USER=findie_search_app
SEARCH_POSTGRES_PASSWORD=GENERATE_SEARCH_DATABASE_PASSWORD
AI_SERVICE_TOKEN=GENERATE_AI_SERVICE_TOKEN

# Load this file with: set -a; . ./.env; set +a
ConnectionStrings__Database="Host=127.0.0.1;Port=${POSTGRES_PORT};Database=${POSTGRES_DB};Username=${POSTGRES_APP_USER};Password=${POSTGRES_APP_PASSWORD};Timeout=5"
# Google OAuth Web client; server only. Redirect URI for the Vite app:
# http://127.0.0.1:5173/api/auth/google/signin
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
Ai__BaseUrl=http://127.0.0.1:8000
Ai__ServiceToken=${AI_SERVICE_TOKEN}
Ai__TimeoutSeconds=5

# R2 is private; credentials stay in the backend. Uploads are not implemented yet.
Storage__Endpoint=
Storage__Bucket=
Storage__AccessKeyId=
Storage__SecretAccessKey=
