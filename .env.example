# Development only. Run python3 scripts/init_env.py to generate local secrets.
POSTGRES_DB=findie
POSTGRES_USER=findie
POSTGRES_PASSWORD=GENERATE_DATABASE_PASSWORD
POSTGRES_PORT=5432
AI_SERVICE_TOKEN=GENERATE_AI_SERVICE_TOKEN

# Load this file with: set -a; . ./.env; set +a
ConnectionStrings__Database="Host=127.0.0.1;Port=${POSTGRES_PORT};Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD};Timeout=5"
Ai__BaseUrl=http://127.0.0.1:8000
Ai__ServiceToken=${AI_SERVICE_TOKEN}
Ai__TimeoutSeconds=5

# R2 is private; credentials stay in the backend. Uploads are not implemented yet.
Storage__Endpoint=
Storage__Bucket=
Storage__AccessKeyId=
Storage__SecretAccessKey=
