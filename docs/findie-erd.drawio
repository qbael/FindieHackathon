        <mxCell id="p2_idempotency_keys_constraints" value="FK (actor_user_id) → app_users(id)&lt;br&gt;resource_id đa loại, có chủ đích KHÔNG phải FK." style="rect;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=12;spacingBottom=10;fontFamily=Helvetica;fontSize=12;fontColor=#546A7B;fillColor=#F9FBFC;strokeColor=#C9D6DF;" vertex="1" parent="p2_idempotency_keys">
