        <mxCell id="legend" value="&lt;b&gt;Đọc sơ đồ&lt;/b&gt;&lt;br&gt;&lt;br&gt;Mỗi hàng là một cột trong DDL: tên cột | kiểu dữ liệu và NULL | ký hiệu khóa.&lt;br&gt;! = NOT NULL; ? = nullable; PK = khóa chính; FK = khóa ngoại; UQn = nhóm UNIQUE được liệt kê dưới bảng.&lt;br&gt;Các cột mang cùng UQn tạo một khóa ghép; WHERE giới hạn phạm vi duy nhất. CHECK đầy đủ xem DDL.&lt;br&gt;1 = đúng một; 0..1 = tùy chọn; 0..N = không hoặc nhiều; 0..3 được giới hạn bằng slot.&lt;br&gt;Đường nối thể hiện quan hệ chính; mọi FK đều được ghi dưới bảng. resource_id của idempotency_keys không phải FK." style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=14;fontColor=#18344B;fillColor=#F4F7F9;strokeColor=#C9D6DF;" vertex="1" parent="1">
          <mxGeometry x="80" y="3327" width="3400" height="180" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
