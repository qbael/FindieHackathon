        <mxCell id="claimrules" value="&lt;b&gt;Không tạo quan hệ giả từ snapshot&lt;/b&gt;&lt;br&gt;&lt;br&gt;claim_answers.question_text_snapshot chụp bộ câu hỏi tại lúc gửi.&lt;br&gt;Không có FK từ claim_answers sang verification_questions.&lt;br&gt;answer_text có thể NULL; chính sách bắt buộc trả lời còn phải chốt.&lt;br&gt;Claim có thể có 0 câu trả lời khi món không đặt câu hỏi." style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=14;fontColor=#18344B;fillColor=#F4F7F9;strokeColor=#C9D6DF;" vertex="1" parent="1">
          <mxGeometry x="850" y="510" width="560" height="156" as="geometry" />
        </mxCell>
        <mxCell id="chatrules" value="&lt;b&gt;Chat đúng hai bên; ghi xong mới phát SignalR&lt;/b&gt;&lt;br&gt;&lt;br&gt;conversations.claim_id là PK; FK ghép bắt buộc approval_status = &amp;#x27;approved&amp;#x27;.&lt;br&gt;Một claim có tối đa một chat; người tham gia lấy từ claimant và reviewer.&lt;br&gt;FK sender chỉ xác nhận tài khoản tồn tại. .NET kiểm tra sender là một trong hai bên.&lt;br&gt;Khóa hàng conversation trước INSERT; commit rồi phát sự kiện để lịch sử không bỏ sót sequence.&lt;br&gt;Mã gửi lại duy nhất theo hội thoại + người gửi + client_message_id." style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=14;fontColor=#18344B;fillColor=#F4F7F9;strokeColor=#C9D6DF;" vertex="1" parent="1">
          <mxGeometry x="60" y="1380" width="2120" height="180" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
