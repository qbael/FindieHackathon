        <mxCell id="p2_e_question" value="1 : 0..3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERzeroToMany;startArrow=ERone;endFill=0;startFill=0;strokeWidth=1.5;strokeColor=#546A7B;fontSize=12;fontFamily=Helvetica;fontColor=#18344B;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.62;entryX=1;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="p2_items" target="p2_verification_questions">
