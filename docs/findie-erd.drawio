          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5_e_original" value="original · 1 : 0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERzeroToOne;startArrow=ERone;endFill=0;startFill=0;strokeWidth=1.5;strokeColor=#546A7B;fontSize=12;fontFamily=Helvetica;fontColor=#18344B;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.24;entryX=0;entryY=0.4;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="p5_stored_objects" target="p5_item_images">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="670" y="850" />
              <mxPoint x="670" y="580" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p5_e_sanitized" value="sanitized · 0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERzeroToOne;startArrow=ERzeroToOne;endFill=0;startFill=0;strokeWidth=1.5;strokeColor=#546A7B;fontSize=12;fontFamily=Helvetica;fontColor=#18344B;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.55;entryX=0;entryY=0.6;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="p5_stored_objects" target="p5_item_images">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="710" y="1080" />
              <mxPoint x="710" y="750" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p5_e_imagejobs" value="(id, item_id) · 0..1 : 0..N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERzeroToMany;startArrow=ERzeroToOne;endFill=0;startFill=0;strokeWidth=1.5;strokeColor=#546A7B;fontSize=12;fontFamily=Helvetica;fontColor=#18344B;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;entryX=0;entryY=0.2;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="p5_item_images" target="p5_ai_jobs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5_e_imageembeddings" value="(id, item_id) · 0..1 : 0..N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERzeroToMany;startArrow=ERzeroToOne;endFill=0;startFill=0;strokeWidth=1.5;strokeColor=#546A7B;fontSize=12;fontFamily=Helvetica;fontColor=#18344B;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.9;entryX=0;entryY=0.9;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="p5_item_images" target="p5_item_embeddings">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1390" y="1120" />
              <mxPoint x="1390" y="1550" />
              <mxPoint x="2120" y="1550" />
              <mxPoint x="2120" y="1090" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="privacy" value="&lt;b&gt;Không lưu URL công khai hoặc URL có chữ ký vào DB&lt;/b&gt;&lt;br&gt;&lt;br&gt;stored_objects là metadata; byte ảnh nằm ở Cloudflare R2.&lt;br&gt;Cả original và sanitized đều ở bucket riêng tư; không bật r2.dev.&lt;br&gt;.NET phục vụ bản đã duyệt qua API; URL ký chỉ là phương án mở rộng.&lt;br&gt;Owner / reviewer → app_users(id), ghi ở FK dưới bảng.&lt;br&gt;Lưu object_key trước upload; chỉ xóa metadata sau khi dọn R2 thành công." style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=14;fontColor=#18344B;fillColor=#F4F7F9;strokeColor=#C9D6DF;" vertex="1" parent="1">
          <mxGeometry x="760" y="1370" width="580" height="180" as="geometry" />
        </mxCell>
        <mxCell id="airules" value="&lt;b&gt;Kết quả AI phải khớp nguồn trước khi lưu&lt;/b&gt;&lt;br&gt;&lt;br&gt;source_version + source_sha256 + model_id + model_revision + processing_profile xác định đầu vào.&lt;br&gt;image_id NULL chỉ dành cho text. FK ghép (image_id, item_id) buộc ảnh thuộc đúng món.&lt;br&gt;Job giữ lease_token / lease_until; retry hữu hạn và bỏ kết quả khi nguồn hoặc lease đã đổi.&lt;br&gt;Vector ảnh được tạo từ bản che đã duyệt. Không embedding ảnh gốc hoặc bằng chứng claim.&lt;br&gt;vector(2048): MVP tìm cosine chính xác; chưa tạo HNSW/IVFFlat cho kiểu vector 2048 chiều.&lt;br&gt;Chỉ tìm bài published / active, nguồn hiện hành và ảnh ready / approved chưa retired.&lt;br&gt;Job và vector không có FK trực tiếp với nhau; liên kết được kiểm tra bằng nguồn / version / model / profile." style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=14;fontColor=#18344B;fillColor=#F4F7F9;strokeColor=#C9D6DF;" vertex="1" parent="1">
          <mxGeometry x="1450" y="1600" width="1280" height="228" as="geometry" />
        </mxCell>
        <mxCell id="keylegend" value="&lt;b&gt;Đọc đầy đủ các khóa&lt;/b&gt;&lt;br&gt;&lt;br&gt;! NOT NULL; ? nullable; PK khóa chính; FK khóa ngoại.&lt;br&gt;UQn là nhóm cột được liệt kê dưới bảng; WHERE là unique có điều kiện.&lt;br&gt;Mọi FK nghiệp vụ ON DELETE RESTRICT; DDL là nguồn chuẩn cho CHECK đầy đủ." style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=14;fontColor=#18344B;fillColor=#F4F7F9;strokeColor=#C9D6DF;" vertex="1" parent="1">
          <mxGeometry x="60" y="1730" width="1280" height="132" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
