              <mxPoint x="1450" y="1410" />
              <mxPoint x="1450" y="1080" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="custodyrules" value="&lt;b&gt;Ràng buộc lịch sử và quyền thao tác&lt;/b&gt;&lt;br&gt;&lt;br&gt;intake_requests.target_point_id → reception_points(id). pending / rejected không đổi nơi giữ.&lt;br&gt;FK ghép kèm item_id chặn liên kết intake hoặc claim thuộc món khác.&lt;br&gt;Mỗi item có tối đa một event registered và một event returned (partial UNIQUE).&lt;br&gt;intake_request_id duy nhất: một yêu cầu nhận thực tế có tối đa một sự kiện.&lt;br&gt;from_custody / to_custody là snapshot JSON; không thay thế FK nơi giữ hiện tại.&lt;br&gt;Nhận tại điểm có thể không có tài khoản người nhận; recipient_user_id được phép NULL.&lt;br&gt;Actor, quyền nhân viên còn hiệu lực và giao dịch nguyên tử do .NET kiểm tra." style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=14;fontColor=#18344B;fillColor=#F4F7F9;strokeColor=#C9D6DF;" vertex="1" parent="1">
          <mxGeometry x="60" y="1520" width="2110" height="228" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
