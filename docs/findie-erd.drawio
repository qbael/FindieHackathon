        <mxCell id="p4_claims_summary_1" value="Có thể liên kết sự kiện trả cho đúng món" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=13;fontColor=#546A7B;fontStyle=0;" vertex="1" parent="p4_claims">
