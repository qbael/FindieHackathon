          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4_e_itemintake" value="1 : 0..N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERzeroToMany;startArrow=ERone;endFill=0;startFill=0;strokeWidth=1.5;strokeColor=#546A7B;fontSize=12;fontFamily=Helvetica;fontColor=#18344B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="p4_items" target="p4_intake_requests">
