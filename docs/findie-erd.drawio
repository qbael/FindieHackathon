        <mxCell id="p5_item_embeddings_constraints" value="UQ1 (item_id, model_id, model_revision, processing_profile) WHERE modality =&lt;br&gt;&amp;#x27;text&amp;#x27;&lt;br&gt;UQ2 (image_id, model_id, model_revision, processing_profile) WHERE modality =&lt;br&gt;&amp;#x27;image&amp;#x27;&lt;br&gt;FK (item_id) → items(id)&lt;br&gt;FK (image_id, item_id) → item_images(id, item_id)&lt;br&gt;CHECK: text không image; image bắt buộc image; dimensions = 2048." style="rect;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=12;spacingBottom=10;fontFamily=Helvetica;fontSize=12;fontColor=#546A7B;fillColor=#F9FBFC;strokeColor=#C9D6DF;" vertex="1" parent="p5_item_embeddings">
          <mxGeometry x="0" y="392" width="560" height="153" as="geometry" />
        </mxCell>
