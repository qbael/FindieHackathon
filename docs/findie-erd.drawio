          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4_e_intakeevent" value="(id, item_id) · 0..1 : 0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERzeroToOne;startArrow=ERzeroToOne;endFill=0;startFill=0;strokeWidth=1.5;strokeColor=#546A7B;fontSize=12;fontFamily=Helvetica;fontColor=#18344B;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.42;entryX=0;entryY=0.6;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="p4_intake_requests" target="p4_custody_events">
          <mxGeometry relative="1" as="geometry" />
