        <mxCell id="p4_e_claimevent" value="(id, item_id) · claim tùy chọn" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERzeroToMany;startArrow=ERzeroToOne;endFill=0;startFill=0;strokeWidth=1.5;strokeColor=#546A7B;fontSize=12;fontFamily=Helvetica;fontColor=#18344B;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.92;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="p4_claims" target="p4_custody_events">
