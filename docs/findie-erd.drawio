        <mxCell id="p2_e_dedupe" value="actor · 1 : 0..N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERzeroToMany;startArrow=ERone;endFill=0;startFill=0;strokeWidth=1.5;strokeColor=#546A7B;fontSize=12;fontFamily=Helvetica;fontColor=#18344B;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.8;entryX=0;entryY=0.2;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="p2_app_users" target="p2_idempotency_keys">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="650" y="480" />
              <mxPoint x="650" y="1240" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="inventoryrules" value="&lt;b&gt;Quy tắc nghiệp vụ cần đọc cùng DDL&lt;/b&gt;&lt;br&gt;&lt;br&gt;items.custody_kind chọn đúng một nơi giữ: cá nhân, điểm trong hệ thống hoặc nơi bên ngoài.&lt;br&gt;holder_user_id → app_users(id), tùy chọn theo nhánh person; posted_by luôn bắt buộc.&lt;br&gt;Sau returned, nơi giữ trên items là nơi cuối cùng trước khi trả; không biến người nhận thành người giữ.&lt;br&gt;Tối đa 3 câu hỏi hiện tại. Claim chụp câu hỏi riêng; sửa câu hỏi không sửa bằng chứng đã gửi.&lt;br&gt;point_staff không phải vai trò toàn hệ thống: quyền bị giới hạn theo point_id và revoked_at.&lt;br&gt;ON DELETE RESTRICT cho các FK. Xác thực, phân quyền và kiểm tra chuyển trạng thái thuộc .NET." style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=14;fontColor=#18344B;fillColor=#F4F7F9;strokeColor=#C9D6DF;" vertex="1" parent="1">
          <mxGeometry x="1430" y="1390" width="700" height="204" as="geometry" />
        </mxCell>
        <mxCell id="legend2" value="&lt;b&gt;Khóa và tính rỗng&lt;/b&gt;&lt;br&gt;&lt;br&gt;PK ghép: mọi cột đánh dấu PK cùng tạo một khóa.&lt;br&gt;UQn là nhóm cột, không phải từng cột độc lập.&lt;br&gt;UQn có WHERE chỉ áp dụng cho các hàng thỏa điều kiện.&lt;br&gt;? chỉ mô tả NULL ở cột; CHECK có thể buộc giá trị theo trạng thái.&lt;br&gt;Các FK phụ được ghi đầy đủ dưới từng bảng, kể cả không có đường nối." style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=14;fontColor=#18344B;fillColor=#F4F7F9;strokeColor=#C9D6DF;" vertex="1" parent="1">
          <mxGeometry x="60" y="1280" width="540" height="180" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
