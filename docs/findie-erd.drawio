        <mxCell id="p4_custody_events_constraints" value="UQ1 (intake_request_id)&lt;br&gt;UQ2 (item_id, custody_version)&lt;br&gt;UQ3 (item_id) WHERE event_kind = &amp;#x27;returned&amp;#x27;&lt;br&gt;UQ4 (item_id) WHERE event_kind = &amp;#x27;registered&amp;#x27;&lt;br&gt;FK (item_id) → items(id)&lt;br&gt;FK (actor_user_id) → app_users(id)&lt;br&gt;FK (recipient_user_id) → app_users(id)&lt;br&gt;FK (intake_request_id, item_id) → intake_requests(id, item_id)&lt;br&gt;FK (claim_id, item_id) → claims(id, item_id)&lt;br&gt;CHECK: shape riêng cho registered / received / returned." style="rect;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=12;spacingBottom=10;fontFamily=Helvetica;fontSize=12;fontColor=#546A7B;fillColor=#F9FBFC;strokeColor=#C9D6DF;" vertex="1" parent="p4_custody_events">
          <mxGeometry x="0" y="421" width="630" height="210" as="geometry" />
        </mxCell>
