        <mxCell id="p3_messages_constraints" value="UQ1 (message_sequence)&lt;br&gt;UQ2 (conversation_id, sender_user_id, client_message_id)&lt;br&gt;FK (conversation_id) → conversations(claim_id)&lt;br&gt;FK (sender_user_id) → app_users(id)&lt;br&gt;message_sequence là IDENTITY (tự cấp số; NOT NULL)." style="rect;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=12;spacingBottom=10;fontFamily=Helvetica;fontSize=12;fontColor=#546A7B;fillColor=#F9FBFC;strokeColor=#C9D6DF;" vertex="1" parent="p3_messages">
